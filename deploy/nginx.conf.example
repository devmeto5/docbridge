# Include inside nginx's http context. Replace the hostname and certificate paths.
# This sample is for a host-level Nginx proxy on the same VPS as Docker Compose.
limit_req_zone $binary_remote_addr zone=docbridge_rate:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=docbridge_connections:10m;

server {
    listen 443 ssl;
    server_name converter.example.com;
    ssl_certificate /etc/letsencrypt/live/converter.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/converter.example.com/privkey.pem;
    client_max_body_size 20m;
    client_body_timeout 30s;

    location / {
        limit_req zone=docbridge_rate burst=5 nodelay;
        limit_conn docbridge_connections 2;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 200s;
        proxy_send_timeout 30s;
        proxy_request_buffering on;
        proxy_buffering off;
        # Avoid persisting document request details in access logs.
        access_log off;
    }
}
